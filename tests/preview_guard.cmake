# Negative integration checks use disposable copies, never the committed files.
cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${root}/build/previews")
endif()
set(expected "${BUILD_DIR}/guard-expected")
file(MAKE_DIRECTORY "${expected}")
foreach(case png svg missing)
  foreach(name device edit transport terminal)
    file(COPY "${root}/previews/${name}.png" "${root}/previews/${name}.svg" DESTINATION "${expected}")
  endforeach()
  if(case STREQUAL "missing")
    file(REMOVE "${expected}/device.png")
  else()
    file(APPEND "${expected}/device.${case}" "stale-image-fixture")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DEXPECTED_DIR=${expected}"
    -P "${root}/tools/rebuild-previews.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "Stale previews:.*device\\.(png|svg)")
    message(FATAL_ERROR "Preview ${case} corruption was not correctly rejected: ${out}${err}")
  endif()
endforeach()
message(STATUS "Stale PNG, stale SVG and missing image were all rejected")
