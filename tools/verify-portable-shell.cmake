file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../portable-shell.lock" lines)
foreach(line IN LISTS lines)
  if(line MATCHES "^([0-9a-fA-F]+)  (.+)$")
    set(expected "${CMAKE_MATCH_1}")
    set(path "${CMAKE_CURRENT_LIST_DIR}/../Ardush/src/portable-shell/${CMAKE_MATCH_2}")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Shared source drift: ${path}; update upstream and repin, never patch the vendor copy")
    endif()
  endif()
endforeach()
message(STATUS "PortableShell pinned files verified")
