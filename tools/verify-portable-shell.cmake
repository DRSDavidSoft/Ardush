cmake_minimum_required(VERSION 3.16)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../portable-shell.lock" lines)
set(required portable_terminal.h portable_editor.h portable_parse.h portable_probe.h portable_shell_editor.hpp portable_device_view.hpp portable_device_table.inc portable_style.h LICENSE)
foreach(line IN LISTS lines)
  if(line MATCHES "^([0-9a-fA-F]+)  (.+)$")
    set(expected "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    string(LENGTH "${expected}" hash_length)
    if(NOT name IN_LIST required OR NOT hash_length EQUAL 64)
      message(FATAL_ERROR "Invalid, duplicate or unexpected lock entry: ${name}")
    endif()
    list(REMOVE_ITEM required "${name}")
    set(path "${CMAKE_CURRENT_LIST_DIR}/../SerialConsole/src/portable-shell/${name}")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Shared source drift: ${path}; update upstream and repin, never patch the vendor copy")
    endif()
  endif()
endforeach()
if(required)
  message(FATAL_ERROR "Missing shared source lock entries: ${required}")
endif()
message(STATUS "PortableShell pinned files verified")
