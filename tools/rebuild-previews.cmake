# Cross-platform, host-only image rebuild/check. No Python or shell scripting.
cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED MODE)
  set(MODE CHECK)
endif()
if(NOT MODE MATCHES "^(CHECK|UPDATE)$")
  message(FATAL_ERROR "MODE must be CHECK or UPDATE")
endif()
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${root}/build/previews")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
if(NOT DEFINED EXPECTED_DIR)
  set(EXPECTED_DIR "${root}/previews")
endif()
set(generated "${BUILD_DIR}/generated")
set(cache "${BUILD_DIR}/dependencies")
file(MAKE_DIRECTORY "${cache}" "${generated}")
include("${root}/tools/verify-portable-shell.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/previews/dependencies.cmake")
file(MAKE_DIRECTORY "${cache}/${replay_sha}")
set(replay_source "${cache}/${replay_sha}/replay.c")
preview_download("${replay_url}" "${replay_sha}" "${replay_source}")
preview_download("${font_url}" "${font_sha}" "${cache}/Agave.ttf")
preview_download("${font_license_url}" "${font_license_sha}" "${cache}/Agave-LICENSE")

if(NOT DEFINED RESVG)
  cmake_host_system_information(RESULT arch QUERY OS_PLATFORM)
  if(NOT arch MATCHES "^(AMD64|amd64|x86_64|x64)$")
    message(FATAL_ERROR "Supply -DRESVG=/path/to/resvg ${resvg_version} on ${arch}; automatic downloads cover x86-64 hosts")
  endif()
  if(CMAKE_HOST_WIN32)
    set(platform windows)
    set(suffix .exe)
  elseif(CMAKE_HOST_APPLE)
    set(platform macos)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(platform linux)
  else()
    message(FATAL_ERROR "Supply -DRESVG=/path/to/resvg ${resvg_version} on this host")
  endif()
  set(archive "${resvg_${platform}_archive}")
  preview_download("${resvg_url}/${archive}" "${resvg_${platform}_sha}" "${cache}/${archive}")
  # Re-extract from the verified archive so a changed executable cannot be reused.
  file(ARCHIVE_EXTRACT INPUT "${cache}/${archive}" DESTINATION "${cache}/resvg-${platform}")
  set(RESVG "${cache}/resvg-${platform}/resvg${suffix}")
endif()
execute_process(COMMAND "${RESVG}" --version OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)
if(NOT version STREQUAL "${resvg_version}")
  message(FATAL_ERROR "Require resvg ${resvg_version}, got ${version}")
endif()

set(configure "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}/previews" -B "${BUILD_DIR}/native"
  "-DREPLAY_SOURCE=${replay_source}" -DCMAKE_BUILD_TYPE=Release)
if(DEFINED GENERATOR)
  list(APPEND configure -G "${GENERATOR}")
endif()
execute_process(COMMAND ${configure} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}/native" --config Release COMMAND_ERROR_IS_FATAL ANY)
set(frames device edit transport terminal full vertical matrix vertical-edit reduced prompt)
set(arguments)
set(managed)
foreach(frame IN LISTS frames)
  list(APPEND managed "${frame}.svg" "${frame}.png")
endforeach()
foreach(frame device edit transport terminal)
  list(APPEND arguments "${generated}/${frame}.svg")
endforeach()
if(CMAKE_HOST_WIN32)
  set(exe .exe)
endif()
execute_process(COMMAND "${BUILD_DIR}/native/bin/console_preview${exe}" ${arguments} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${BUILD_DIR}/native/bin/full_preview${exe}"
  "${generated}/full.svg" "${generated}/vertical.svg" "${generated}/matrix.svg" "${generated}/vertical-edit.svg" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${BUILD_DIR}/native/bin/reduced_preview${exe}" "${generated}/reduced.svg" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${BUILD_DIR}/native/bin/prompt_preview${exe}" "${generated}/prompt.svg" COMMAND_ERROR_IS_FATAL ANY)
foreach(frame IN LISTS frames)
  # One explicitly supplied font; two-times resolution for smooth display scaling.
  execute_process(COMMAND "${RESVG}" --skip-system-fonts --use-font-file "${cache}/Agave.ttf"
    --zoom 2 "${generated}/${frame}.svg" "${generated}/${frame}.png" COMMAND_ERROR_IS_FATAL ANY)
endforeach()

# All local README preview references must be managed by this rebuild.
file(READ "${root}/README.md" readme)
string(REGEX MATCHALL "previews/[A-Za-z0-9_.-]+\\.(png|svg)" references "${readme}")
foreach(reference IN LISTS references)
  get_filename_component(name "${reference}" NAME)
  if(NOT name IN_LIST managed)
    message(FATAL_ERROR "README references an unmanaged image: ${reference}")
  endif()
endforeach()
file(GLOB present RELATIVE "${EXPECTED_DIR}" "${EXPECTED_DIR}/*.svg" "${EXPECTED_DIR}/*.png")
foreach(name IN LISTS present)
  if(NOT name IN_LIST managed)
    message(FATAL_ERROR "Unmanaged preview image: ${name}; add its generating fixture explicitly")
  endif()
endforeach()
set(stale)
foreach(name IN LISTS managed)
  if(MODE STREQUAL "UPDATE")
    file(MAKE_DIRECTORY "${EXPECTED_DIR}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${generated}/${name}" "${EXPECTED_DIR}/${name}"
      COMMAND_ERROR_IS_FATAL ANY)
  elseif(NOT EXISTS "${EXPECTED_DIR}/${name}")
    list(APPEND stale "${name} (missing)")
  else()
    file(SHA256 "${generated}/${name}" fresh)
    file(SHA256 "${EXPECTED_DIR}/${name}" committed)
    if(NOT fresh STREQUAL committed)
      list(APPEND stale "${name}")
    endif()
  endif()
endforeach()
if(stale)
  message(FATAL_ERROR "Stale previews: ${stale}\nRun cmake -DMODE=UPDATE -P tools/rebuild-previews.cmake and commit the results. Fresh images: ${generated}")
endif()
list(LENGTH frames frame_count)
message(STATUS "Preview ${MODE} passed: all ${frame_count} SVG/PNG pairs; pinned Agave and resvg ${resvg_version}")
