cmake_minimum_required(VERSION 3.20)
if(NOT IS_DIRECTORY "${PORTABLE_SHELL_SOURCE}/include")
  message(FATAL_ERROR "Set PORTABLE_SHELL_SOURCE to a clean canonical PortableShell checkout")
endif()
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${PORTABLE_SHELL_SOURCE}" OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git status --porcelain -- include LICENSE WORKING_DIRECTORY "${PORTABLE_SHELL_SOURCE}" OUTPUT_VARIABLE dirty COMMAND_ERROR_IS_FATAL ANY)
if(dirty OR NOT revision STREQUAL PORTABLE_SHELL_REVISION)
  message(FATAL_ERROR "Require clean shared files and an explicit matching PORTABLE_SHELL_REVISION")
endif()
set(destination "${CMAKE_CURRENT_LIST_DIR}/../Ardush/src/portable-shell")
set(manifest "# https://github.com/atomicdeploy/portable-shell\n# commit ${revision}\n")
foreach(name portable_terminal.h portable_editor.h portable_parse.h portable_probe.h portable_shell_editor.hpp portable_device_view.hpp)
  configure_file("${PORTABLE_SHELL_SOURCE}/include/${name}" "${destination}/${name}" COPYONLY)
  file(SHA256 "${destination}/${name}" checksum)
  string(APPEND manifest "${checksum}  ${name}\n")
endforeach()
configure_file("${PORTABLE_SHELL_SOURCE}/LICENSE" "${destination}/LICENSE" COPYONLY)
file(SHA256 "${destination}/LICENSE" checksum)
string(APPEND manifest "${checksum}  LICENSE\n")
file(WRITE "${CMAKE_CURRENT_LIST_DIR}/../portable-shell.lock" "${manifest}")
