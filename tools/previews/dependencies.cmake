function(preview_download url sha path)
  if(EXISTS "${path}")
    file(SHA256 "${path}" actual)
    if(actual STREQUAL sha)
      return()
    endif()
    message(FATAL_ERROR "Cached preview dependency changed: ${path}; restore or remove that file before retrying")
  endif()
  # Native curl uses the host certificate store on Windows. Some CMake bundles
  # lack that store; never work around a certificate failure by disabling TLS.
  find_program(preview_curl NAMES curl)
  if(preview_curl)
    execute_process(COMMAND "${preview_curl}" --fail --location --silent --show-error
      --proto =https --proto-redir =https --tlsv1.2 --output "${path}.download" "${url}"
      RESULT_VARIABLE code ERROR_VARIABLE detail)
  else()
    file(DOWNLOAD "${url}" "${path}.download" TLS_VERIFY ON STATUS status)
    list(GET status 0 code)
    set(detail "${status}")
  endif()
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Cannot fetch pinned preview dependency ${url}: ${detail}")
  endif()
  file(SHA256 "${path}.download" actual)
  if(NOT actual STREQUAL sha)
    message(FATAL_ERROR "Downloaded preview dependency hash mismatch: ${url}")
  endif()
  file(RENAME "${path}.download" "${path}")
endfunction()
